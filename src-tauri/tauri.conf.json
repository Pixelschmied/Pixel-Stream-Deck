{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixel Gaming Helper",
  "version": "0.1.1",
  "identifier": "dev.pixelschmied.pixel-gaming-helper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pixel Gaming Helper",
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Pixelschmied/Pixel-Stream-Deck/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1RTc3NTE3REJCOTEyMUIKUldRYkVybmJGM1huOVkvdmJFZUJGbFFQUzhOckVKMUFIV2FSaUxuVVd6Z2piN0F2bGZVM2xIeDQK"
    }
  }
}
